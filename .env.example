# Copy this file to .env and fill in real values. NEVER commit .env.

PORT=5000
NODE_ENV=production

# Signs login tokens. Long random string. Changing it logs every user out.
JWT_SECRET=
# Signs charger QR codes. All printed QR stickers depend on it - NEVER change it
# once QR codes are in the field. (If unset, JWT_SECRET is used instead.)
QR_SECRET=

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_SECRET_KEY=
RAZORPAY_WEBHOOK_SECRET=

# MSG91 SMS gateway (empty = mock mode, no SMS sent)
MSG91_AUTH_KEY=

# Optional fixed-OTP test logins (store reviewers / testers). Both required.
# OTP_TEST_NUMBERS=9000000001,9000000002
# OTP_TEST_CODE=

# Public base URL chargers use: <base>/ocpp/<chargePointId>
OCPP_WS_BASE_URL=

# Database (MySQL) - all four of HOST/USER/PASSWORD/NAME are required
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_MAX_POOL=200
DB_MIN_POOL=5
